#!/bin/sh
# Aircoins host tool: install the official ZeroTier package.
# This helper intentionally accepts no arguments and is the only command
# exposed to the aircoins service user through sudoers.
set -eu

if [ "$#" -ne 0 ]; then
  echo "This installer does not accept arguments." >&2
  exit 64
fi
if [ "$(id -u)" -ne 0 ]; then
  echo "This installer must run as root." >&2
  exit 77
fi
if [ ! -r /etc/os-release ] || ! command -v curl >/dev/null 2>&1; then
  echo "A Debian-family host with curl is required." >&2
  exit 78
fi
# shellcheck disable=SC1091
. /etc/os-release
case "${ID:-}" in
  debian|ubuntu|armbian) ;;
  *) echo "ZeroTier installer supports Debian, Ubuntu and Armbian only." >&2; exit 78 ;;
esac
case "$(uname -m)" in
  x86_64|aarch64|arm64|armv7l) ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 78 ;;
esac
if command -v zerotier-cli >/dev/null 2>&1; then
  systemctl enable --now zerotier-one
  echo "ZeroTier is already installed."
  exit 0
fi

exec 9>/run/lock/aircoins-zerotier-install.lock
flock -n 9 || { echo "Another ZeroTier installation is already running." >&2; exit 75; }
installer="$(mktemp /tmp/aircoins-zerotier.XXXXXX)"
trap 'rm -f "$installer"' EXIT INT TERM
curl --proto '=https' --tlsv1.2 -fsSL https://install.zerotier.com -o "$installer"
sh "$installer"
command -v zerotier-cli >/dev/null 2>&1 || {
  echo "ZeroTier installer completed without creating zerotier-cli." >&2
  exit 1
}
systemctl enable --now zerotier-one
echo "ZeroTier installation completed."
