#!/bin/sh
# Aircoins host tool: install the official ZeroTier package.
# This helper intentionally accepts no arguments and is the only command
# exposed to the aircoins service user through sudoers.
set -eu

if [ "$#" -gt 2 ]; then
  echo "Usage: $0 [info|listnetworks|join|leave] <network-id>" >&2
  exit 64
fi
if [ "$#" -eq 1 ]; then
  case "$1" in
    info|listnetworks) ;;
    *) echo "Unsupported ZeroTier action." >&2; exit 64 ;;
  esac
elif [ "$#" -eq 2 ]; then
  case "$1" in
    join|leave) ;;
    *) echo "Unsupported ZeroTier action." >&2; exit 64 ;;
  esac
  case "$2" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
    *) echo "Invalid ZeroTier network ID." >&2; exit 64 ;;
  esac
fi
if [ "$(id -u)" -ne 0 ]; then
  echo "This installer must run as root." >&2
  exit 77
fi
if [ ! -r /etc/os-release ] || ! command -v curl >/dev/null 2>&1; then
  echo "A Debian-family host with curl is required." >&2
  exit 78
fi
# shellcheck disable=SC1091
. /etc/os-release
case "${ID:-}" in
  debian|ubuntu|armbian) ;;
  *) echo "ZeroTier installer supports Debian, Ubuntu and Armbian only." >&2; exit 78 ;;
esac
case "$(uname -m)" in
  x86_64|aarch64|arm64|armv7l) ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 78 ;;
esac
if [ "$#" -gt 0 ] && ! command -v zerotier-cli >/dev/null 2>&1; then
  echo "ZeroTier is not installed on this host." >&2
  exit 69
fi
if command -v zerotier-cli >/dev/null 2>&1; then
  case "${1:-install}" in
    info) exec zerotier-cli -j info ;;
    listnetworks) exec zerotier-cli -j listnetworks ;;
    join) exec zerotier-cli join "$2" ;;
    leave) exec zerotier-cli leave "$2" ;;
    install)
      systemctl enable --now zerotier-one
      echo "ZeroTier is already installed."
      exit 0
      ;;
  esac
fi

exec 9>/run/lock/aircoins-zerotier-install.lock
flock -n 9 || { echo "Another ZeroTier installation is already running." >&2; exit 75; }
curl -s https://install.zerotier.com | sudo bash
command -v zerotier-cli >/dev/null 2>&1 || {
  echo "ZeroTier installer completed without creating zerotier-cli." >&2
  exit 1
}
systemctl enable --now zerotier-one
echo "ZeroTier installation completed."
